#!/usr/bin/env node
// Navidezni CasparCG za razvoj in teste (ne predvaja ničesar).
'use strict';
const fs = require('fs');
const net = require('net');
const cfg = fs.readFileSync(process.argv[2], 'utf8');
const port = parseInt(/<port>(\d+)<\/port>/.exec(cfg)[1], 10);
const log = (s) => process.stdout.write(`[mock] ${s}\n`);
const dev = /<device-name>(.*)<\/device-name>/.exec(cfg);
if (dev && process.env.MOCK_AUDIO_DEVICES && !process.env.MOCK_AUDIO_DEVICES.split('|').includes(dev[1])) {
  // Kot pravi CasparCG: izpiše seznam naprav in napako, a teče naprej (brez zvoka).
  log('[info]    -------- OpenAL Devices -------');
  for (const d of process.env.MOCK_AUDIO_DEVICES.split('|')) log(`[info]    ${d}`);
  log('[info]    -------- OpenAL Devices -------');
  log(`[error]   [struct caspar::tag_msg_info * __ptr64] = Invalid OpenAL device: ${dev[1]}`);
}
const srv = net.createServer((sock) => {
  let buf = '';
  sock.on('data', (d) => {
    buf += d;
    let i;
    while ((i = buf.indexOf('\r\n')) !== -1) {
      const line = buf.slice(0, i); buf = buf.slice(i + 2);
      log(`AMCP ${line}`);
      const cmd = line.split(' ')[0].toUpperCase();
      if (cmd === 'VERSION') sock.write('201 VERSION OK\r\n2.5.1 mock\r\n');
      else if (cmd === 'INFO') sock.write('200 INFO OK\r\n1 1080p5000 PLAYING\r\n\r\n');
      else if (cmd === 'CRASH') process.exit(3);
      else if (cmd === 'BAD') sock.write('400 ERROR\r\n');
      else sock.write(`202 ${cmd} OK\r\n`);
    }
  });
  sock.on('error', () => {});
});
srv.listen(port, '127.0.0.1', () => log(`listening ${port}`));
process.stdin.on('data', (d) => { if (/^q/m.test(String(d))) { log('quit'); process.exit(0); } });
